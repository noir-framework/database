<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="noirapi/database"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Mess detection for noirapi/database. The public API is source-compatible with
        opis/database, so rules that would force renaming public methods or parameters are
        tuned below; structural exceptions are declared with @SuppressWarnings on the class.
    </description>

    <rule ref="rulesets/cleancode.xml">
        <!-- distinct / $is_column / $clear flags are part of the opis/database public API. -->
        <exclude name="BooleanArgumentFlag" />
        <exclude name="StaticAccess" />
    </rule>
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <properties>
            <!-- Named constructors used throughout the builders: Expression::fromClosure(),
                 JsonPath::fromArrow() / fromPath(). -->
            <property name="exceptions" value="\Noirapi\Database\SQL\Expression,\Noirapi\Database\SQL\JsonPath" />
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml">
        <!-- Fluent builders expose one public method per SQL feature (where/orWhere/in/notIn/...). -->
        <exclude name="TooManyPublicMethods" />
        <exclude name="TooManyMethods" />
    </rule>

    <rule ref="rulesets/controversial.xml" />
    <rule ref="rulesets/design.xml" />

    <rule ref="rulesets/naming.xml">
        <exclude name="ShortMethodName" />
        <exclude name="ShortVariable" />
        <exclude name="LongVariable" />
    </rule>
    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <!-- SQL comparison vocabulary of the public API. -->
            <property name="exceptions" value="is,eq,ne,lt,gt,in,on,op" />
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <!-- AlterTable::renameColumn($from, $to) keeps its public parameter names. -->
            <property name="exceptions" value="to" />
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <!-- Descriptive option names such as $throwTransactionExceptions. -->
            <property name="maximum" value="30" />
        </properties>
    </rule>
</ruleset>
